# =============================================================================
# usque — переменные окружения контейнера
#   cp .env.example .env
# Пустые/закомментированные значения = «взять дефолт usque».
# =============================================================================

# ------------------------------------------------------------------ образ
USQUE_IMAGE=usque:local
USQUE_REF=main                  # ветка/тег/коммит usque для сборки
TZ=UTC

# ------------------------------------------------------------------ режим
# tun | socks | http-proxy | l4-socks | l4-http-proxy | portfw | register | enroll
USQUE_MODE=tun

# Дополнительные режимы одновременно с основным (раскомментируйте нужное):
# EXTRA_SOCKS_PORT=1080         # tun + socks5 на порту 1080
# EXTRA_HTTP_PORT=8000          # tun + http-proxy на порту 8000
# EXTRA_L4_SOCKS_PORT=1081      # tun + l4-socks (только TCP)
# EXTRA_L4_HTTP_PORT=8001

# ------------------------------------------------------------- конфиг WARP
USQUE_CONFIG=/etc/usque/config.json
# auto  — зарегистрировать, если конфига нет/он пустой (по умолчанию)
# force — перезаписать конфиг (создаст НОВОЕ устройство в аккаунте!)
# never — никогда не регистрировать, падать если конфига нет
USQUE_REGISTER=auto
# USQUE_DEVICE_NAME=my-router      # имя устройства в панели Cloudflare

# ------------------------------------------- Cloudflare Zero Trust (team token)
# С ним USQUE_REGISTER=auto само зарегистрирует устройство в вашей организации,
# а SNI переключится на zt-masque.cloudflareclient.com автоматически.
# USQUE_JWT=<team-token из Zero Trust Dashboard → Settings → WARP Client → Device enrollment>
# USQUE_SNI=zt-masque.cloudflareclient.com
# USQUE_ENROLL_ON_START=1        # освежать ключ при каждом старте (ZT-адреса живут недолго)
# USQUE_ENROLL_STRICT=1          # падать, если enroll не удался

# -------------------------------------------------------------- SNI и DPI
# Если провайдер режет MASQUE (туннель не поднимается: в логе таймаут соединения
# с эндпоинтом) — подставьте SNI домена, который через DPI проходит:
# USQUE_SNI=example.com
# example.com — заглушка: подставьте реальный домен, доступный у вашего провайдера
# и обслуживаемый Cloudflare. С дефолтным consumer-masque.cloudflareclient.com
# в таких сетях туннель обычно не поднимается, а с проходящим доменом — поднимается
# и отдаёт warp=on.
# Запасной вариант в тех же условиях: USQUE_HTTP2=1 (HTTP/2 по TCP вместо QUIC).

# ------------------------------------------------------------------ TUN
USQUE_IFACE=usque-tun           # имя интерфейса, ≤15 символов
# USQUE_MTU=1280                # менять не рекомендуется
# USQUE_NO_IPROUTE2=0           # 1 = usque не назначает адрес и не поднимает link
# USQUE_TUN_PERSIST=0           # 1 = не удалять интерфейс при выходе

# ------------------------------------------------------------- маршрутизация
# none  — не трогать маршруты (usque сам маршруты не ставит)
# main  — default через tun в основной таблице + обход эндпоинта (по умолчанию)
# table — то же, но в отдельной таблице + ip rule; основная таблица не меняется
ROUTE_MODE=main
# ROUTE_TABLE=100                # номер таблицы для ROUTE_MODE=table
# ROUTE_RULE_PRIO=1000           # приоритет ip rule
# ROUTE_EXCLUDE="10.0.0.0/8 192.168.0.0/16"   # эти подсети — мимо туннеля
# ROUTE_IPV6=auto                # auto | 1 | 0

# ------------------------------------------------------------- туннель/сеть
# USQUE_HTTP2=1                  # HTTP/2 по TCP+TLS вместо QUIC/H3 (полезно там,
#                                # где QUIC/UDP режут)
# USQUE_IPV6_ENDPOINT=1          # подключаться к эндпоинту по IPv6
# USQUE_NO_TUNNEL_IPV4=1         # выключить IPv4 внутри туннеля
# USQUE_NO_TUNNEL_IPV6=1         # выключить IPv6 внутри туннеля
# USQUE_CONNECT_PORT=443         # порт MASQUE-соединения
# USQUE_KEEPALIVE=30s
# USQUE_RECONNECT_DELAY=1s
# USQUE_ALWAYS_RECONNECT=0       # 1 = переподключаться даже в простое
# USQUE_INSECURE=0               # 1 = не проверять сертификат эндпоинта
# USQUE_DNS="9.9.9.9 149.112.112.112"   # только для прокси-режимов

# ------------------------------------------------------------------ прокси
# USQUE_BIND=0.0.0.0
# USQUE_SOCKS_PORT=1080
# USQUE_HTTP_PORT=8000
# USQUE_PROXY_USER=user
# USQUE_PROXY_PASS=pass
# USQUE_PROXY_LOCAL_DNS=1        # резолвить имена на хосте, а не в туннеле
# USQUE_PROXY_SYSTEM_DNS=1

# ------------------------------------------------------------ свои хуки
# USQUE_ON_CONNECT=/etc/usque/hooks/my-on-connect.sh
# USQUE_ON_DISCONNECT=/etc/usque/hooks/my-on-disconnect.sh
# USQUE_EXTRA_ARGS=""            # сырые аргументы в конец команды usque

# ------------------------------------------------------------- диагностика
# USQUE_DRYRUN=1                 # показать команду запуска и выйти
# HEALTHCHECK_TUNNEL=1           # реальная проверка туннеля (curl warp=on)
